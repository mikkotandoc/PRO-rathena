# AETHER Online environment sample.
# Copy values you need into an untracked environment or a private shell profile.
# Never commit real credentials.

# Trace | Debug | Information | Warning | Error | Critical
AETHER_LOG_LEVEL=Information

# Future PostgreSQL connection for the dedicated server only.
# Leave this unset until a database slice exists.
# Shape, with placeholders rather than a real secret:
# AETHER_DB_CONNECTION_STRING=Host=<host>;Port=5432;Database=aether;Username=<user>;Password=<from-secret-store>
