; Engine configuration file.
config_version=5

[application]

config/name="AETHER Online Server"
config/description="AETHER Online dedicated server"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility", "C#")
config/icon="res://icon.svg"

[aether]

role="dedicated-server"
headless=true

[dotnet]

project/assembly_name="AetherServer"

[rendering]

renderer/rendering_method="gl_compatibility"
