 static void HD(byte[] b,long st,const int len){
  long end=Math.Min(st+len,b.Length); for(long off=st;off<end;) {
   int n=(int)Math.Min(16,end-off); var hx=new StringBuilder(); var as=new StringBuilder();
   for(int k=0;k<n;k++){ hx.AppendFormat("{X2} ",b[off+k]); byte c=b[off+k]; as.Append(c>=32&&c<=126?(char)c:'.');}
   for(int k=n;k<16;k++)hx.Append("   "); L(""+(off.ToString("X8")+"  "+hx.ToString()+" "+as.ToString()); off+=n;}}
